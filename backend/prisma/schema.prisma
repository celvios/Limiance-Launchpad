generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Core token record — mirrors on-chain TokenConfig, extended with off-chain data
// ─────────────────────────────────────────────────────────────────────────────

model Token {
  id                  String    @id @default(cuid())
  mint                String    @unique
  tokenAddress        String?   @unique
  saleAddress         String?
  chainId             Int       @default(97)
  creator             String
  name                String
  symbol              String
  uri                 String
  description         String    @default("")

  // On-chain supply data (stored as BigInt to match u64)
  supplyCap           BigInt
  currentSupply       BigInt    @default(0)
  graduationThreshold BigInt
  creatorAllocation   Int

  // Curve configuration
  curveType           String    // "sigmoid"
  curveParamA         BigInt
  curveParamB         BigInt
  curveParamC         BigInt

  // Lifecycle
  status              String    @default("active")  // "active" | "graduated" | "cancelled"
  dexPoolAddress      String?

  // Timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  trades    Trade[]
  comments  Comment[]

  @@index([status])
  @@index([createdAt])
  @@index([creator])
  @@index([symbol])
  @@index([tokenAddress])
  @@index([chainId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trade events indexed from BSC contract events
// ─────────────────────────────────────────────────────────────────────────────

model Trade {
  id            String   @id @default(cuid())
  tokenMint     String
  tokenAddress  String?
  walletAddress String
  type          String   // "buy" | "sell"
  amount        BigInt   // token amount (smallest unit, 6 decimals)
  solAmount     BigInt   // legacy payment amount
  paymentAmount BigInt?
  paymentAsset  String   @default("0x0000000000000000000000000000000000000000")
  pricePerToken BigInt   // wei per token
  txSignature   String   @unique
  timestamp     DateTime
  isWhale       Boolean  @default(false)

  token Token @relation(fields: [tokenMint], references: [mint])

  @@index([tokenMint])
  @@index([walletAddress])
  @@index([timestamp])
  @@index([tokenMint, timestamp])
  @@index([tokenAddress])
}

model User {
  id                    String   @id @default(cuid())
  email                 String?  @unique
  emailVerifiedAt       DateTime?
  primaryWalletAddress  String?  @unique
  embeddedSignerAddress String?
  smartAccountAddress   String?
  authType              String   @default("wallet")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  wallets          WalletIdentity[]
  emailIdentities  EmailIdentity[]
  depositAddresses DepositAddress[]
  balances         UserBalance[]

  @@index([email])
  @@index([primaryWalletAddress])
}

model WalletIdentity {
  id            String   @id @default(cuid())
  userId        String
  walletAddress String   @unique
  walletType    String   @default("external")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailIdentity {
  id        String   @id @default(cuid())
  userId    String
  email     String   @unique
  provider  String   @default("email_otp")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model LoginOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, consumed])
}

model DepositAddress {
  id               String   @id @default(cuid())
  userId           String?
  userWallet       String
  chainId          Int
  asset            String
  vaultAddress     String   @unique
  status           String   @default("active")
  lastScannedBlock BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deposits Deposit[]
  user     User?     @relation(fields: [userId], references: [id])

  @@unique([userWallet, chainId, asset])
  @@unique([userId, chainId, asset])
  @@index([userWallet])
  @@index([userId])
  @@index([chainId, asset])
}

model Deposit {
  id               String   @id @default(cuid())
  depositAddressId String
  vaultAddress     String
  userWallet       String
  chainId          Int
  asset            String
  amount           BigInt
  txHash           String
  logIndex         Int      @default(0)
  confirmations    Int      @default(0)
  credited         Boolean  @default(false)
  consumed         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  depositAddress DepositAddress @relation(fields: [depositAddressId], references: [id])

  @@unique([txHash, logIndex])
  @@index([userWallet, asset])
  @@index([vaultAddress])
  @@index([credited, consumed])
}

model UserBalance {
  id            String   @id @default(cuid())
  userId        String?
  walletAddress String
  chainId       Int
  asset         String
  available     BigInt   @default(0)
  consumed      BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@unique([walletAddress, chainId, asset])
  @@unique([userId, chainId, asset])
  @@index([walletAddress])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Comments — signed with wallet key, stored off-chain
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id            String   @id @default(cuid())
  tokenMint     String
  walletAddress String
  message       String   @db.Text
  signature     String?  // ed25519 signature (legacy) — now superseded by JWT auth
  upvotes       Int      @default(0)
  createdAt     DateTime @default(now())

  token Token @relation(fields: [tokenMint], references: [mint])

  @@index([tokenMint])
  @@index([tokenMint, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User profiles — off-chain, wallet-keyed
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  username        String   @unique          // lowercase — for uniqueness checks
  usernameDisplay String   @default("")     // original casing — for display
  bio             String   @default("") @db.Text
  profilePicUri  String   @default("")   // IPFS URI
  coverUri       String   @default("")   // IPFS URI
  onboarded      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([username])
  @@index([onboarded])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social graph
// ─────────────────────────────────────────────────────────────────────────────

model Follow {
  id              String   @id @default(cuid())
  followerWallet  String
  followingWallet String
  createdAt       DateTime @default(now())

  @@unique([followerWallet, followingWallet])
  @@index([followerWallet])
  @@index([followingWallet])
}

// ─────────────────────────────────────────────────────────────────────────────
// Watchlist
// ─────────────────────────────────────────────────────────────────────────────

model Watchlist {
  id            String   @id @default(cuid())
  walletAddress String
  tokenMint     String
  createdAt     DateTime @default(now())

  @@unique([walletAddress, tokenMint])
  @@index([walletAddress])
}

// ─────────────────────────────────────────────────────────────────────────────
// Comment upvotes (normalized to prevent double-voting)
// ─────────────────────────────────────────────────────────────────────────────

model CommentUpvote {
  id            String   @id @default(cuid())
  commentId     String
  walletAddress String
  createdAt     DateTime @default(now())

  @@unique([commentId, walletAddress])
  @@index([commentId])
}



